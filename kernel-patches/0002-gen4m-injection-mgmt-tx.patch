 #ifdef CFG_SUPPORT_SNIFFER_RADIOTAP
 int mtk_cfg80211_set_monitor_channel(struct wiphy *wiphy,
 				struct cfg80211_chan_def *chandef);
+int wlanMonitorInject(struct GLUE_INFO *prGlueInfo,
