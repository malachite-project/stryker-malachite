# Kernel config fragment — malachite Wi-Fi monitor mode + injection
#
# The gen4m wlan module reads CONFIG_SNIFFER_RADIOTAP from the kernel build to
# turn on -DCFG_SUPPORT_SNIFFER_RADIOTAP (monitor RX) and -DCFG_SUPPORT_PDMA_
# SCATTER. Patch 0001 also sets this inside Kbuild.6878 so the module is enabled
# regardless of the kernel config, but set it here too for completeness if the
# kernel build selects module config via fragments.
#
# Apply alongside the device/GKI defconfig in the kernel_manifest-6.1 build.
CONFIG_SNIFFER_RADIOTAP=y

# NOTE: CFG_SUPPORT_TX_MGMT_USE_DATAQ (needed for injection) is a driver CFG_
# macro, not a kernel Kconfig — it is set via ccflags in Kbuild.6878 (patch
# 0001), not here.
